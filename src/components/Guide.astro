---
// The whole guide on one page: the locale home. Sections live in
// src/content/sections/<locale>/NN-<slug>.mdx; each keeps its anchor id on
// the <section> wrapper (#vpn, #t-signal…) so deep links resolve here.
// The same content is also split into one page per section and per tool for
// search engines (src/pages/[...path].astro); links to those section pages
// fold back into anchors here (InPageLinks). Tool is injected into MDX scope.
import { render } from 'astro:content'
import { useT, type Locale } from '../i18n/config'
import { loadGuide } from '../lib/guide'
import Allies from './Allies.astro'
import Checklist from './Checklist.astro'
import Directory from './Directory.astro'
import Hero from './Hero.astro'
import Manifesto from './Manifesto.astro'
import InPageLinks from './nav/InPageLinks.astro'
import Observatory from './Observatory.astro'
import ShareRow from './ShareRow.astro'
import StatusBanner from './StatusBanner.astro'
import Timeline from './Timeline.astro'
import Tool from './Tool.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useT(locale)

// Reading order and part numbers (00…) come from loadGuide, the single
// source shared with the section pages: they match the PART NN headers.
const pages = await loadGuide(locale)
const sections = await Promise.all(
  pages
    .filter((p) => p.entry)
    .map(async (p) => ({ id: p.id, Content: (await render(p.entry!)).Content })),
)
// The manifesto closes the guide without a part number of its own.
const tocEntries = [
  ...pages.map((p) => ({ id: p.id, title: p.title, prefix: p.prefix })),
  { id: 'manifesto', title: t('manifesto.label'), prefix: '' },
]
---

<Hero locale={locale} />
<StatusBanner locale={locale} />
<InPageLinks locale={locale}>
  <main id="content" class="mx-auto max-w-3xl px-4 py-8">
    <nav
      id="toc"
      aria-label={t('nav.toc')}
      class="my-8 rounded-dossier border border-rule bg-surface p-5"
    >
      <p class="eyebrow mt-0 mb-3">{t('nav.toc')}</p>
      <ul class="m-0 list-none gap-6 p-0 text-sm leading-7 sm:columns-2">
        {
          tocEntries.map((s) => (
            <li class="m-0">
              <a href={`#${s.id}`} class="text-ink no-underline hover:text-accent">
                <span class="toc-p" aria-hidden="true">
                  {s.prefix}
                </span>
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      sections.map(({ id, Content }) => (
        <section id={id}>
          <Content components={{ Tool }} />
        </section>
      ))
    }
    <Timeline locale={locale} />
    <Observatory locale={locale} />
    <Allies locale={locale} />
    <Directory locale={locale} />
    <Checklist locale={locale} />
    <Manifesto locale={locale} />
    <ShareRow locale={locale} />
  </main>
</InPageLinks>
