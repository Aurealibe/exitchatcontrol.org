---
// Every page of the split guide, in every locale (see src/lib/pages.ts):
// one page per section, per dataset section, per tool card, plus the whole
// guide on one page. More specific routes (/[lang]/, /quiz) win over this one.
import { render } from 'astro:content'
import Allies from '../components/Allies.astro'
import Checklist from '../components/Checklist.astro'
import Directory from '../components/Directory.astro'
import Guide from '../components/Guide.astro'
import Breadcrumbs from '../components/nav/Breadcrumbs.astro'
import Pager from '../components/nav/Pager.astro'
import ToolMini from '../components/nav/ToolMini.astro'
import Observatory from '../components/Observatory.astro'
import Timeline from '../components/Timeline.astro'
import Tool from '../components/Tool.astro'
import { locales, useT, type Locale } from '../i18n/config'
import Base from '../layouts/Base.astro'
import { loadGuide, loadTools, snippet, type GuidePage, type GuideTool } from '../lib/guide'
import { allLocales, homeHref, pageHref, sectionHref, toolHref } from '../lib/pages'
import type { PageId } from '../i18n/slugs'

type Props =
  | { kind: 'full'; locale: Locale }
  | { kind: 'page'; locale: Locale; id: string }
  | { kind: 'tool'; locale: Locale; id: string }

export async function getStaticPaths() {
  const strip = (href: string) => href.replace(/^\/|\/$/g, '')
  const paths = []
  for (const locale of locales) {
    paths.push({
      params: { path: strip(pageHref(locale, 'full')) },
      props: { kind: 'full', locale },
    })
    for (const page of await loadGuide(locale)) {
      if (page.kind === 'hub') continue
      paths.push({
        params: { path: strip(page.href) },
        props: { kind: 'page', locale, id: page.id },
      })
      for (const id of page.tools) {
        paths.push({
          params: { path: strip(toolHref(locale, id)) },
          props: { kind: 'tool', locale, id },
        })
      }
    }
  }
  return paths
}

const props = Astro.props as Props
const { locale } = props
const t = useT(locale)
const pages = await loadGuide(locale)
const home = { name: t('guide.home'), href: homeHref(locale) }
const sitename = 'Exit Chat Control'

let page: GuidePage | undefined
let tool: GuideTool | undefined
let siblings: GuideTool[] = []
if (props.kind !== 'full') {
  const tools = await loadTools(locale)
  if (props.kind === 'tool') {
    tool = tools.get(props.id)!
    page = pages.find((p) => p.id === tool!.tool.section)!
  } else {
    page = pages.find((p) => p.id === props.id)!
  }
  siblings = page.tools.map((id) => tools.get(id)!)
}

// Reading order for the pager: section pages, then the dataset pages.
const order = pages.filter((p) => p.kind !== 'hub')
const at = page ? order.indexOf(page) : -1
const prevPage = order[at - 1]
const nextPage = order[at + 1]
const link = (p?: GuidePage) => p && { href: p.href, title: p.title, prefix: p.prefix }

const toolAt = tool ? siblings.indexOf(tool) : -1
const prevTool = siblings[toolAt - 1]
const nextTool = siblings[toolAt + 1]
const toolLink = (x?: GuideTool) => x && { href: x.href, title: x.name }

// <head> metadata
let title: string
let description: string
let hrefs: Record<Locale, string>
let breadcrumbs: { name: string; href: string }[] = []
let schema: Record<string, unknown>[] = []
if (props.kind === 'full') {
  title = t('seo.fullTitle')
  description = t('site.description')
  hrefs = allLocales((l) => pageHref(l, 'full'))
} else if (tool) {
  title = t('seo.toolTitle').replace('{name}', tool.name)
  description = snippet(tool.what)
  hrefs = allLocales((l) => toolHref(l, tool!.tool.id))
  breadcrumbs = [
    home,
    { name: page!.title, href: page!.href },
    { name: tool.name, href: tool.href },
  ]
  schema = [
    {
      '@type': 'SoftwareApplication',
      name: tool.name,
      url: tool.tool.url,
      description,
      applicationCategory: 'SecurityApplication',
      ...(tool.tool.pricing === 'free'
        ? { offers: { '@type': 'Offer', price: 0, priceCurrency: 'EUR' } }
        : {}),
    },
  ]
} else {
  const names = siblings.slice(0, 3).map((s) => s.name.split(' · ')[0])
  // "VPN : la vérité" already has a colon: join the tool names with a dash.
  const colon = page!.title.includes(':') ? ' — ' : locale === 'fr' ? ' : ' : ': '
  title = names.length
    ? `${page!.title}${colon}${names.join(', ')} · ${sitename}`
    : `${page!.title} · ${sitename}`
  description = page!.description || t('site.description')
  hrefs = allLocales((l) =>
    page!.kind === 'data' ? pageHref(l, page!.id as PageId) : sectionHref(l, page!.id),
  )
  breadcrumbs = [home, { name: page!.title, href: page!.href }]
}

const Content = page?.entry && props.kind === 'page' ? (await render(page.entry)).Content : null
const DATA = {
  precedents: Timeline,
  observatory: Observatory,
  allies: Allies,
  directory: Directory,
  checklist: Checklist,
}
const DataSection = page?.kind === 'data' ? DATA[page.id as keyof typeof DATA] : null
---

<Base
  locale={locale}
  title={title}
  description={description}
  hrefs={hrefs}
  breadcrumbs={breadcrumbs}
  schema={schema}
  noindex={props.kind === 'full'}
>
  {
    props.kind === 'full' ? (
      <Guide locale={locale} />
    ) : (
      <main id="content" class="mx-auto max-w-3xl px-4 py-8">
        <div class="page-head">
          <Breadcrumbs label={t('guide.breadcrumb')} items={breadcrumbs} />
          {tool && (
            <a href={page!.href} class="back-link">
              ← {t('guide.backTo').replace('{section}', page!.title)}
            </a>
          )}
        </div>

        {tool ? (
          <>
            <Tool id={tool.tool.id} variant="page" />
            {(prevTool || nextTool) && (
              <Pager
                label={t('guide.pager')}
                prevLabel={t('guide.prev')}
                nextLabel={t('guide.next')}
                prev={toolLink(prevTool)}
                next={toolLink(nextTool)}
              />
            )}
            {siblings.length > 1 && (
              <section aria-labelledby="alternatives">
                <h2 id="alternatives" class="alt-title">
                  {t('guide.alternatives')}
                </h2>
                <ul class="tool-mini-grid">
                  {siblings
                    .filter((s) => s !== tool)
                    .map((s) => (
                      <li>
                        <ToolMini item={s} />
                      </li>
                    ))}
                </ul>
              </section>
            )}
          </>
        ) : (
          <>
            {Content && (
              <section id={page!.id}>
                <Content components={{ Tool, h2: 'h1' }} />
              </section>
            )}
            {DataSection && <DataSection locale={locale} heading="h1" />}
          </>
        )}

        <p class="quiz-cta">
          <a href={`${homeHref(locale)}quiz/`}>{t('guide.quizCta')} →</a>
        </p>

        {!tool && (
          <Pager
            label={t('guide.pager')}
            prevLabel={t('guide.prev')}
            nextLabel={t('guide.next')}
            prev={link(prevPage)}
            next={link(nextPage)}
          />
        )}
      </main>
    )
  }
</Base>
